#!/usr/bin/env bash
set -euo pipefail

STATE_DIR=/var/lib/vpnx-enrollment
AUTHORIZED_KEYS=/root/.ssh/authorized_keys
mkdir -p "$STATE_DIR"
chmod 700 "$STATE_DIR"

read -r action device_id public_blob extra <<< "${SSH_ORIGINAL_COMMAND:-}"
[[ "$action" == enroll && "$device_id" =~ ^[A-Za-z0-9_.-]{1,96}$ && "$public_blob" =~ ^[A-Za-z0-9+/=]{300,1200}$ && -z "${extra:-}" ]] || {
    printf '{"ok":false,"error":"invalid request"}\n'
    exit 2
}

exec 9>"$STATE_DIR/lock"
flock -x 9
record="$STATE_DIR/$device_id"
if [[ -s "$record" ]]; then
    read -r adb_port control_port token < "$record"
else
    counter=25566
    [[ -s "$STATE_DIR/next-port" ]] && read -r counter < "$STATE_DIR/next-port"
    adb_port=$counter
    control_port=$((counter + 1))
    printf '%s\n' $((counter + 2)) > "$STATE_DIR/next-port"
    token="$(openssl rand -hex 32)"
    printf '%s %s %s\n' "$adb_port" "$control_port" "$token" > "$record"
    chmod 600 "$record" "$STATE_DIR/next-port"
fi

comment="vpnx-auto-$device_id"
if ! grep -Fq "$comment" "$AUTHORIZED_KEYS"; then
    printf 'command="/bin/sleep 31536000",restrict,port-forwarding,permitlisten="127.0.0.1:%s",permitlisten="127.0.0.1:%s" ssh-rsa %s %s\n' \
        "$adb_port" "$control_port" "$public_blob" "$comment" >> "$AUTHORIZED_KEYS"
fi
printf '{"ok":true,"adbPort":%s,"controlPort":%s,"token":"%s"}\n' "$adb_port" "$control_port" "$token"
