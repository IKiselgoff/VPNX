<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.vpnx.bird-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/USERNAME/.vpnx/bin/vpnx-bird-sync</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/USERNAME/.vpnx/bird-sync.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/USERNAME/.vpnx/bird-sync.err.log</string>
</dict>
</plist>
