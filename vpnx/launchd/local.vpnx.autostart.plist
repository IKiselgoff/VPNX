<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.vpnx.autostart</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/USERNAME/.vpnx/bin/vpnx</string>
    <string>start</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/USERNAME/.vpnx/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/USERNAME/.vpnx/launchd.err.log</string>
</dict>
</plist>