#!/usr/bin/env python3
"""Read-only forced SSH command for the current BIRD snapshot."""
import json
from pathlib import Path

path = Path('/var/lib/vpnx-bird/snapshot.json')
with path.open('rb') as handle:
    import os
    timestamp = os.fstat(handle.fileno()).st_mtime
    configs = json.load(handle)
print(json.dumps({'updated_at': timestamp, 'configs': configs}, ensure_ascii=False))
