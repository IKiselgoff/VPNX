#!/usr/bin/env python3
"""Refresh the private BIRD snapshot and Telegram candidate list on the VPS."""

import json
import os
import subprocess
import tempfile
import urllib.parse
from pathlib import Path


SNAPSHOT = Path(os.getenv("BIRD_SNAPSHOT", "/var/lib/vpnx-bird/snapshot.json"))
NODES = Path(os.getenv("BIRD_TELEGRAM_NODES", "/etc/teplon-auto/telegram_proxy_nodes.txt"))
PROXY_SERVICE = os.getenv("BIRD_PROXY_SERVICE", "TeplonTelegramProxy.service")


def atomic_write(path: Path, content: str, mode: int) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def load_snapshot() -> list[dict]:
    if SNAPSHOT.stat().st_size > 2_000_000:
        raise ValueError("BIRD snapshot exceeds size limit")
    configs = json.loads(SNAPSHOT.read_text(encoding="utf-8"))
    if not isinstance(configs, list) or not 5 <= len(configs) <= 100:
        raise ValueError("BIRD snapshot has invalid profile count")
    for config in configs:
        if not isinstance(config, dict) or not config.get("remarks") or not config.get("inbounds"):
            raise ValueError("BIRD snapshot has invalid profile metadata")
        if not any(o.get("protocol") == "vless" for o in config.get("outbounds", [])):
            raise ValueError("BIRD snapshot has a profile without VLESS")
    return configs


def vless_link(outbound: dict, title: str) -> str | None:
    if outbound.get("protocol") != "vless":
        return None
    server = ((outbound.get("settings") or {}).get("vnext") or [None])[0]
    if not isinstance(server, dict):
        return None
    user = (server.get("users") or [None])[0]
    if not isinstance(user, dict):
        return None
    address, port, uid = server.get("address"), server.get("port", 443), user.get("id")
    if not address or address == "0.0.0.0" or not uid:
        return None
    stream = outbound.get("streamSettings") or {}
    reality = stream.get("realitySettings") or {}
    if stream.get("security") != "reality" or not reality.get("publicKey"):
        return None
    network = stream.get("network", "tcp")
    if network not in {"tcp", "xhttp"}:
        return None
    params = {
        "type": network,
        "security": "reality",
        "sni": reality.get("serverName") or address,
        "fp": reality.get("fingerprint") or "chrome",
        "pbk": reality["publicKey"],
        "spx": reality.get("spiderX", "/"),
    }
    if user.get("flow"):
        params["flow"] = user["flow"]
    if network == "xhttp":
        xhttp = stream.get("xhttpSettings") or stream.get("xHTTPSettings") or {}
        params["path"] = xhttp.get("path") or "/"
        params["mode"] = xhttp.get("mode") or "auto"
        if xhttp.get("host"):
            params["host"] = xhttp["host"]
        if xhttp.get("extra"):
            params["extra"] = json.dumps(xhttp["extra"], separators=(",", ":"))
    authority = f"{urllib.parse.quote(str(uid), safe='')}@{address}:{port}"
    return f"vless://{authority}?{urllib.parse.urlencode(params)}#{urllib.parse.quote(title, safe='')}"


def candidate_links(configs: list[dict]) -> list[str]:
    links = []
    seen = set()
    for config in configs:
        for outbound in config["outbounds"]:
            link = vless_link(outbound, config["remarks"])
            if link and link.split("#", 1)[0] not in seen:
                links.append(link)
                seen.add(link.split("#", 1)[0])
    if not links:
        raise ValueError("BIRD snapshot contains no usable Telegram candidates")
    return links


def main() -> None:
    try:
        configs = load_snapshot()
        links = candidate_links(configs)
        existing = NODES.read_text(encoding="utf-8").splitlines() if NODES.exists() else []
        # Keep legacy candidates as a last-resort fallback; never interrupt active Xray here.
        combined = list(dict.fromkeys(links + [line for line in existing if line.startswith("vless://")]))
        atomic_write(NODES, "\n".join(combined) + "\n", 0o600)
        print(f"BIRD mirror consumed: {len(configs)} profiles, {len(links)} new candidates, {len(combined)} total")
    except Exception as error:
        print(f"BIRD mirror kept last-good data: {type(error).__name__}: {error}")

    if not PROXY_SERVICE:
        return
    if proxy_healthy():
        print("Telegram SOCKS healthy; active Xray unchanged")
        return
    if proxy_healthy():
        print("Telegram SOCKS recovered on retry; active Xray unchanged")
        return
    print("Telegram SOCKS failed twice; restarting selector")
    subprocess.run(["systemctl", "restart", PROXY_SERVICE], check=True, timeout=120)
    if not proxy_healthy():
        raise RuntimeError("Telegram SOCKS remains unhealthy after selector restart")


def proxy_healthy() -> bool:
    try:
        result = subprocess.run(
            ["curl", "-sS", "--socks5-hostname", "127.0.0.1:10808", "-o", "/dev/null",
             "-w", "%{http_code}", "--connect-timeout", "5", "--max-time", "12", "https://api.telegram.org"],
            capture_output=True, text=True, check=False, timeout=15,
        )
        return result.returncode == 0 and result.stdout.strip().startswith(("2", "3"))
    except subprocess.TimeoutExpired:
        return False


if __name__ == "__main__":
    main()
